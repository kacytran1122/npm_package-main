{
  "name": "selakata",
  "version": "0.1.0",
  "description": "Internationalization built for Southeast Asia: 12 countries, 29 locales, numeral classifiers, Buddhist Era dates, Zawgyi detection, and line breaking for unspaced scripts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sela": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "test": "node --test test/*.test.js",
    "bench": "node bench/segmentation.mjs",
    "bench:footprint": "node bench/footprint.mjs",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "i18n", "internationalization", "l10n", "southeast-asia", "asean",
    "vietnamese", "thai", "indonesian", "malay", "filipino", "khmer",
    "burmese", "lao", "tetum", "jawi", "zawgyi", "classifier",
    "buddhist-era", "line-breaking", "react"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.27.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
