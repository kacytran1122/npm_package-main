{
  "name": "selakata",
  "version": "0.1.0",
  "description": "Internationalization built for Southeast Asia: 12 countries, 29 locales, numeral classifiers, Buddhist Era dates, Zawgyi detection, and line breaking for unspaced scripts.",
  "type": "module",
  "license": "MIT",
  "author": "Kacy",
  "homepage": "https://github.com/kacytran1122/npm_package-main#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kacytran1122/npm_package-main.git",
    "directory": "packages/sdk"
  },
  "bugs": { "url": "https://github.com/kacytran1122/npm_package-main/issues" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sela": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./react": {
      "import": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
      "require": { "types": "./dist/react.d.cts", "default": "./dist/react.cjs" }
    },
    "./server": {
      "import": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
      "require": { "types": "./dist/server.d.cts", "default": "./dist/server.cjs" }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": ["./dist/react.d.ts"],
      "server": ["./dist/server.d.ts"]
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.js",
    "bench": "node bench/segmentation.mjs",
    "bench:footprint": "node bench/footprint.mjs",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "i18n", "internationalization", "l10n", "southeast-asia", "asean",
    "vietnamese", "thai", "indonesian", "malay", "filipino", "khmer",
    "burmese", "lao", "tetum", "jawi", "zawgyi", "classifier",
    "buddhist-era", "line-breaking", "react"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.27.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
