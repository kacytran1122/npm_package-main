---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import WrapDemo from "../components/WrapDemo.astro";
import SeamInspector from "../components/SeamInspector.tsx";
import Playground from "../components/Playground.tsx";
import { COUNTRIES, LOCALE_CODES, LOCALES, unspacedLocales } from "selakata";

// Every number on this page is read out of the package at build time. If the
// registry changes, the marketing copy changes with it.
const localeCount = LOCALE_CODES.length;
const countryCount = Object.keys(COUNTRIES).length;
const unspacedCount = unspacedLocales().length;
const rtlCount = LOCALE_CODES.filter((c) => LOCALES[c].dir === "rtl").length;
const codeMixed = LOCALE_CODES.filter((c) => LOCALES[c].codeMixed);

const stats = [
  { value: String(countryCount), label: "Countries" },
  { value: String(localeCount), label: "Languages" },
  { value: String(unspacedCount), label: "Languages with no spaces" },
  { value: "MIT", label: "Licence" },
];

const comparison = [
  { row: "Wrapping text that has no spaces", them: false },
  { row: "Counting words, so numbers read correctly", them: false },
  { row: "Politeness that changes with who is speaking", them: false },
  { row: "Javanese and Sundanese speech levels", them: false },
  { row: "The Thai calendar, used automatically", them: false },
  { row: "Finding and fixing broken Burmese text", them: false },
  { row: "Singlish, Taglish and other mixed languages", them: false },
  { row: "Currencies that should not show cents", them: "partial" },
  { row: "The right font for each writing system", them: false },
  { row: "Falling back to a nearby language, not English", them: "partial" },
  { row: "Plural rules", them: true },
  { row: "Putting values into text", them: true },
];

const features = [
  {
    title: "Text that wraps instead of overflowing",
    body: "Thai, Lao, Khmer, and Burmese have no spaces, so CSS has nowhere to start a new line. This works out where the words end and marks the safe spots. It runs on React Native too, where the browser's own version does not exist.",
    api: "insertLineBreakOpportunities()",
  },
  {
    title: "Counting that reads correctly",
    body: "“2 mèo” is broken Vietnamese. You need a counting word in the middle. Where it goes changes by language: Vietnamese puts it before the noun, Thai puts it after.",
    api: "formatCount()",
  },
  {
    title: "Politeness that fits the speaker",
    body: "In Thai, the polite word at the end of a sentence changes depending on whether a man or a woman is speaking. Hard-code ครับ and your app sounds like a man talking, to everyone, forever.",
    api: "politeParticle()",
  },
  {
    title: "Speech levels, not just formal and casual",
    body: "Javanese has three levels: ngoko, madya, and krama. Sundanese has loma and lemes. Both fit onto one simple three-step scale, so a single piece of text can hold all its versions.",
    api: "speechLevel()",
  },
  {
    title: "Burmese text that arrives broken",
    body: "Burmese is stored in two different formats that look identical in the wrong font and turn to nonsense in the right one. Check text as it comes in, and repair the old format before it reaches your database.",
    api: "detectMyanmarEncoding()",
  },
  {
    title: "Money and dates written the local way",
    body: "The dong, rupiah, riel, kip, and kyat never show cents, because nobody writes them that way. Thai dates use the Thai calendar, because that is what every Thai form prints.",
    api: "formatCurrency()",
  },
  {
    title: "Name fields that accept real names",
    body: "Burmese names have no family name. Many Indonesians legally have just one name. A required last-name box turns those people away at sign-up.",
    api: "nameFields()",
  },
  {
    title: "A checker for regional mistakes",
    body: "Finds missing counting words, hard-coded polite words, English-style plurals, text that will overflow, and placeholders that do not match. It runs in your build, before anyone reviews it.",
    api: "lintBundle()",
  },
];

/*
 * Three alternatives, not three steps, so they are labelled by the thing that
 * actually separates them: whose server the translations live on.
 */
const install = [
  {
    runs: "No server",
    title: "Bundled",
    body: "Keep your text in a JSON file. No account, no other packages, and it never calls the internet.",
    code: `import th from "./locales/th.json";

<I18nProvider
  locale="th"
  bundles={{ th }}
>
  <App />
</I18nProvider>`,
  },
  {
    runs: "Our server",
    title: "Hosted",
    body: "Give the library a project key and it fetches your text. Translators work in the dashboard, and AI drafts wait for a person to approve them.",
    code: `<I18nProvider
  locale="th"
  apiKey={env.SELAKATA_KEY}
  project="acme-web"
>
  <App />
</I18nProvider>`,
  },
  {
    runs: "Your server",
    title: "Self-hosted",
    body: "Run the API, the database, and the dashboard yourself. Your keys, your data, on your own servers.",
    code: `cp .env.example .env
# JWT_SECRET: 32+ chars
./deploy.sh
# dashboard :80
# api       :80/api/v1`,
    lang: "bash" as const,
  },
];

const quickstart = `import { I18nProvider, useTranslation } from "selakata/react";

function Checkout() {
  const { t, currency, count } = useTranslation();

  return (
    <>
      <h1>{t("cart.title")}</h1>
      <p>{count(3, "หนังสือ", { category: "book" })}</p>
      <p>{currency(2500)}</p>
      <p>{t("thanks", {}, { polite: true })}</p>
    </>
  );
}`;
---

<Base
  title="selakata — translation tools built for Southeast Asia"
  description="A translation toolkit for Vietnamese, Thai, Indonesian, Malay, Filipino, Khmer, Burmese, Lao and more. Handles text that has no spaces, counting words, politeness levels, local calendars, and broken Burmese text."
>
  <!-- ============================================================= hero -->
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{countryCount} countries · {localeCount} languages</p>
        <h1>Translation that works in Southeast Asia</h1>
        <p class="lede">
          Most translation libraries were built for European languages. They give
          you plural rules and date formats, then assume the rest is swapping
          words from a list. That falls apart here. Four of these languages do not
          put spaces between words at all — so your text runs straight off the
          screen.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#install">Get started</a>
          <a
            class="btn btn--ghost"
            href="https://github.com/kacytran1122/npm_package-main"
            rel="noopener">View on GitHub</a
          >
        </div>

        <div class="hero__install">
          <code>npm install selakata</code>
          <span class="tag">no runtime deps</span>
        </div>
      </div>

      <div class="hero__demo">
        <SeamInspector client:load />
      </div>
    </div>
  </section>

  <!-- ============================================================ stats -->
  <section class="section section--flush stats-band">
    <div class="shell">
      <dl class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <dd>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ========================================================== problem -->
  <section class="section" id="problem">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">The main problem</p>
        <h2>Your text runs off the edge of the screen</h2>
        <p class="lede">
          This is not a small styling issue. Khmer has no spaces, so the browser
          cannot find anywhere to start a new line. The text just keeps going, past
          the edge of the box, on every phone in the country. No amount of careful
          translation fixes it.
        </p>
      </div>

      <div class="problem">
        <div class="problem__demo">
          <WrapDemo />
        </div>
        <div class="problem__aside">
          <CodeBlock
            code={`import { insertLineBreakOpportunities } from "selakata";

const safe = insertLineBreakOpportunities(text, "km");`}
            label="The whole fix"
          />
          <p class="muted problem__note">
            If the browser supports <code>word-break: auto-phrase</code>, use that
            instead. This is for everywhere CSS cannot reach: text inside images,
            canvas drawings, generated PDFs, and email.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================= comparison -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Compared with i18next and react-intl</p>
        <h2>What you would have to build yourself</h2>
        <p class="lede">
          The general-purpose libraries do the general-purpose parts well, and this
          is not a complaint about them. It is a list of what you end up writing
          yourself the first time you launch in this region.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">i18next / react-intl</th>
              <th scope="col">selakata</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((c) => (
                <tr>
                  <th scope="row">{c.row}</th>
                  <td>
                    {c.them === true ? (
                      <span class="yes">Built in</span>
                    ) : c.them === "partial" ? (
                      <span class="muted">Partly</span>
                    ) : (
                      <span class="no">You write it</span>
                    )}
                  </td>
                  <td><span class="yes">Built in</span></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================================================= features -->
  <section class="section" id="features">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>What it handles for you</h2>
      </div>

      <div class="grid grid--3">
        {
          features.map((f) => (
            <article class="panel feature">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
              <code class="feature__api">{f.api}</code>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= playground -->
  <section class="section" id="playground">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Try it</p>
        <h2>Four things that go wrong. Change them and watch.</h2>
        <p class="lede">
          Everything below is worked out by the real library, running in your
          browser right now. None of it is a picture.
        </p>
      </div>

      <Playground client:visible />
    </div>
  </section>

  <!-- ============================================================= code -->
  <section class="section">
    <div class="shell code-split">
      <div>
        <p class="eyebrow">React</p>
        <h2>Set it up once, then forget about it</h2>
        <p class="lede" style="margin-top:16px">
          <code>useTranslation()</code> hands you tools that already know the
          current language and who is speaking. Your components never need to check
          which country they are rendering for.
        </p>
        <p class="lede" style="margin-top:16px">
          On the server, import from <code>selakata/server</code> instead. That
          version leaves out everything that needs a browser.
        </p>
      </div>
      <CodeBlock code={quickstart} lang="tsx" label="Checkout.tsx" />
    </div>
  </section>

  <!-- ========================================================== install -->
  <section class="section" id="install">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Three ways to set it up</p>
        <h2>Start with a JSON file. Add a server later, if you ever need one.</h2>
      </div>

      <div class="grid grid--3">
        {
          install.map((m) => (
            <article class="panel mode">
              <span class="mode__runs">{m.runs}</span>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
              <CodeBlock code={m.code} lang={m.lang ?? "tsx"} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================== languages -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">{localeCount} languages</p>
        <h2>Including the ones people really type</h2>
        <p class="lede">
          Singlish, Manglish, Taglish, and bahasa gaul are treated as real
          languages here, not as broken English or broken Indonesian.
          {rtlCount} of them read right to left.
        </p>
      </div>

      <ul class="langs">
        {
          LOCALE_CODES.map((code) => {
            const l = LOCALES[code];
            return (
              <li class="lang">
                <span class="lang__native" lang={code} dir={l.dir}>
                  {l.nativeName}
                </span>
                <span class="lang__code">{code}</span>
              </li>
            );
          })
        }
      </ul>

      <p class="langs__foot">
        <a href="/languages/">See every language, writing system, and calendar →</a>
      </p>
    </div>
  </section>

  <!-- ============================================================== cta -->
  <section class="section cta">
    <div class="shell cta__inner">
      <h2>Add it to your app today</h2>
      <p class="lede">
        Free and open source. No account, no tracking. It works with plain JSON
        files and never sends anything anywhere.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#install">How to set it up</a>
        <a class="btn btn--ghost" href="/benchmarks/">See how we tested it</a>
      </div>
      <p class="cta__mix">
        {codeMixed.map((c) => <span lang={c}>{LOCALES[c].nativeName}</span>)}
      </p>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------- problem */

  .problem {
    display: grid;
    grid-template-columns: auto minmax(300px, 1fr);
    gap: 48px;
    align-items: start;
  }

  /* WrapDemo emits the two cards and its gloss as siblings, so it needs a
     wrapper of its own or they become separate grid items. */
  .problem > * {
    min-width: 0;
  }

  .problem__note {
    margin-top: 18px;
    font-size: 0.9rem;
  }

  .problem__note code {
    color: var(--jade);
  }

  @media (max-width: 900px) {
    .problem {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  /* ------------------------------------------------------------- hero */

  .hero {
    padding-block: clamp(48px, 6vw, 88px) clamp(56px, 6vw, 96px);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -30% 40% 40% -20%;
    background: radial-gradient(closest-side, rgb(47 211 180 / 9%), transparent);
    pointer-events: none;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 56px;
    align-items: center;
    position: relative;
  }

  .hero__copy h1 {
    margin-bottom: 22px;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 30px;
  }

  .hero__install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--seam);
  }

  .hero__install code {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ------------------------------------------------------------ stats */

  .stats-band {
    padding-block: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 0;
    border-block: 1px solid var(--seam);
  }

  .stat {
    padding: 26px 22px;
    border-left: 1px solid var(--seam);
  }

  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat dd {
    margin: 0;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.6rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat dt {
    margin-top: 9px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* --------------------------------------------------------- features */

  .feature {
    display: flex;
    flex-direction: column;
  }

  .feature p {
    margin-top: 11px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* The API name sits on the card's bottom edge so the row reads as a list of
     entry points rather than eight ragged paragraphs. */
  .feature__api {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--seam);
    font-size: 0.78rem;
    color: var(--jade);
  }

  /* ------------------------------------------------------------- code */

  .code-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 44px;
    align-items: center;
  }

  .code-split > * {
    min-width: 0;
  }

  .code-split code {
    color: var(--jade);
  }

  /* ------------------------------------------------------------ modes */

  .mode__runs {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid rgb(47 211 180 / 30%);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--jade);
  }

  .mode h3 {
    margin-top: 10px;
  }

  .mode p {
    margin-top: 10px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* ------------------------------------------------------------ langs */

  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    border-top: 1px solid var(--seam);
    border-left: 1px solid var(--seam);
  }

  .lang {
    padding: 15px 16px;
    border-right: 1px solid var(--seam);
    border-bottom: 1px solid var(--seam);
    min-width: 0;
    transition: background-color 0.18s var(--step);
  }

  .lang:hover {
    background: var(--raised);
  }

  .lang__native {
    display: block;
    font-size: 1.02rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .lang__code {
    display: block;
    margin-top: 3px;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
  }

  .langs__foot {
    margin-top: 22px;
  }

  .langs__foot a {
    color: var(--jade);
    font-size: 0.92rem;
  }

  .langs__foot a:hover {
    text-decoration: underline;
  }

  /* -------------------------------------------------------------- cta */

  .cta__inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 18px;
  }

  .cta__inner .lede {
    margin-inline: auto;
  }

  .cta .hero__cta {
    justify-content: center;
    margin-top: 8px;
  }

  .cta__mix {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid var(--seam);
    width: min(100%, 640px);
    color: var(--faint);
    font-size: 0.9rem;
  }
</style>
