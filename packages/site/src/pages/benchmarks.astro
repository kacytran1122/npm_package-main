---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";

/*
 * The numbers here come from `npm run bench` in packages/sdk, run on Node 24
 * with ICU 78.3. They are transcribed rather than computed at build time on
 * purpose: the ICU baseline column cannot be reproduced without running the
 * comparison on a specific runtime, and a number that quietly changes with
 * whichever machine built the site is not a benchmark.
 *
 * Source of truth: packages/sdk/docs/segmentation.md
 */

const RUNTIME = "Node 24.18, ICU 78.3, Unicode 17.0";

const accuracy = [
  { locale: "th", name: "Thai", intl: 95.5, rules: 52.4, lexical: 92.6 },
  { locale: "lo", name: "Lao", intl: 93.0, rules: 58.5, lexical: 100.0 },
  { locale: "km", name: "Khmer", intl: 93.0, rules: 55.1, lexical: 97.4 },
  { locale: "my", name: "Burmese", intl: 97.0, rules: 82.3, lexical: 98.1 },
  { locale: "zh-Hans-SG", name: "Chinese", intl: 88.9, rules: 78.0, lexical: 96.3 },
];

const macro = { intl: 93.5, rules: 65.3, lexical: 96.9 };

const safety = [
  { locale: "th", offsets: 498, illegal: 99, reason: "orphaned trailing vowel ×62" },
  { locale: "lo", offsets: 263, illegal: 60, reason: "orphaned trailing vowel ×46" },
  { locale: "km", offsets: 205, illegal: 0, reason: "— on ICU 78; 44 on ICU 76" },
  { locale: "my", offsets: 279, illegal: 130, reason: "coda split from syllable ×66" },
  { locale: "zh-Hans-SG", offsets: 122, illegal: 0, reason: "—" },
];

const throughput = [
  { locale: "th", intl: 27895, rules: 5920, lexical: 3777 },
  { locale: "lo", intl: 26515, rules: 6540, lexical: 4640 },
  { locale: "km", intl: 31489, rules: 7311, lexical: 4636 },
  { locale: "my", intl: 27317, rules: 7982, lexical: 6459 },
  { locale: "zh-Hans-SG", intl: 11369, rules: 6815, lexical: 4700 },
];

const footprint = [
  { target: "Locale registry (shared baseline)", min: "10.0", gzip: "2.3", marginal: "—" },
  { target: "Rules only", min: "15.3", gzip: "4.6", marginal: "+2.3" },
  { target: "With lexicon (shipped default)", min: "46.0", gzip: "12.3", marginal: "+10.0" },
  { target: "Whole package entry point", min: "82.8", gzip: "24.9", marginal: "—" },
];

const pct = (n: number) => n.toFixed(1);
const num = (n: number) => n.toLocaleString("en-US");
---

<Base
  title="How we tested it — selakata"
  description="Why we wrote our own word splitter instead of using the browser's: accuracy against hand-marked sentences, where each one cuts text wrongly, whether the answer changes between versions, speed, and download size."
>
  <section class="section section--flush head">
    <div class="shell">
      <p class="eyebrow">Evaluation · {RUNTIME}</p>
      <h1>Why we wrote our own word splitter</h1>
      <p class="lede">
        Everything in this library depends on knowing where one word ends and the
        next begins. Browsers have a built-in tool for this, and using it is the
        obvious move — it is what every other translation library does. It turns
        out to be the wrong move here, for reasons we could measure.
      </p>
      <p class="lede">
        We built three versions and tested all three on the same sentences. This
        page shows what we found. The method, the test sentences, and the
        weaknesses are all in the repository.
      </p>

      <div class="head__cta">
        <a
          class="btn btn--ghost"
          href="https://github.com/kacytran1122/npm_package-main/blob/main/packages/sdk/docs/segmentation.md"
          rel="noopener">Read the full writeup</a
        >
        <a
          class="btn btn--ghost"
          href="https://github.com/kacytran1122/npm_package-main/blob/main/packages/sdk/bench/data/corpus.json"
          rel="noopener">See the test sentences</a
        >
      </div>
    </div>
  </section>

  <!-- ====================================================== approaches -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">What we compared</p>
        <h2>Three ways to do the same job</h2>
      </div>

      <div class="grid grid--3">
        <article class="panel approach">
          <span class="approach__key">A</span>
          <h3>The browser's own</h3>
          <p class="muted">
            Let the browser do it. This is what we used before, and it is what we
            are comparing against. It only exists in our test code now — shipping
            it would bring the problem back.
          </p>
        </article>
        <article class="panel approach">
          <span class="approach__key">B</span>
          <h3>Spelling rules only</h3>
          <p class="muted">
            Work out the safe cut points from how each script is written. Thai and
            Lao write some vowels before the letter they belong to, Khmer stacks
            letters on top of each other, and Burmese marks the end of a syllable.
            No word list at all.
          </p>
        </article>
        <article class="panel approach approach--on">
          <span class="approach__key">C</span>
          <h3>Rules plus a word list</h3>
          <p class="muted">
            Take the safe cut points from B, then pick the split that best matches
            a list of common words. Anything it does not recognise falls back to
            B. This is the one we ship.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================== accuracy -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Accuracy</p>
        <h2>How often it finds the right word boundaries</h2>
        <p class="lede">
          We marked up the sentences by hand and split them into two halves. We
          only ever looked at the first half while building the word list. Nothing
          was added or tuned because of a sentence in the second half. These are
          the second-half scores — the ones that count.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Locale</th>
              <th scope="col">A · the browser</th>
              <th scope="col">B · rules only</th>
              <th scope="col">C · rules + word list</th>
            </tr>
          </thead>
          <tbody>
            {
              accuracy.map((r) => {
                const best = Math.max(r.intl, r.rules, r.lexical);
                return (
                  <tr>
                    <th scope="row">
                      <code>{r.locale}</code> <span class="muted">{r.name}</span>
                    </th>
                    <td class={r.intl === best ? "win" : ""}>{pct(r.intl)}</td>
                    <td class={r.rules === best ? "win" : ""}>{pct(r.rules)}</td>
                    <td class={r.lexical === best ? "win" : ""}>{pct(r.lexical)}</td>
                  </tr>
                );
              })
            }
            <tr class="total">
              <th scope="row">Average</th>
              <td>{pct(macro.intl)}</td>
              <td>{pct(macro.rules)}</td>
              <td class="win">{pct(macro.lexical)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="note">
        C only loses on Thai, by 2.9 points, and it loses on compound words: the
        browser's Thai dictionary holds tens of thousands of words and ours holds
        264. Where C wins, it wins because the browser misses Khmer and Chinese
        words that our small, well-chosen list happens to have. You can close the
        Thai gap for your own app straight away with
        <code>registerWords()</code>.
      </p>
    </div>
  </section>

  <!-- ==================================================== determinism -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Consistency</p>
        <h2>The browser gives different answers on different versions</h2>
        <p class="lede">
          This is the finding that becomes a real bug, not just a footnote. The
          same 220 sentences, split on two versions of Node:
        </p>
      </div>

      <div class="diff">
        <div class="diff__stat">
          <strong>19 / 220</strong>
          <span>came out differently between the two versions</span>
        </div>
        <div class="diff__stat diff__stat--good">
          <strong>0 / 220</strong>
          <span>differ with our version, across all three</span>
        </div>
      </div>

      <div class="sample">
        <p class="sample__label">
          <code>ខ្ញុំស្រឡាញ់</code> — same code, same text, two answers
        </p>
        <div class="sample__row">
          <span class="sample__tag sample__tag--bad">ICU 76.1</span>
          <span lang="km" class="sample__text">ខ្|ញុំ|ស្|រ|ឡា|ញ់</span>
        </div>
        <div class="sample__row">
          <span class="sample__tag">ICU 78.3</span>
          <span lang="km" class="sample__text">ខ្ញុំ|ស្រ|ឡា|ញ់</span>
        </div>
      </div>

      <p class="note">
        The older version pulls apart Khmer letters that are meant to stack
        together. The newer one does not. If your app builds pages on the server
        and then loads them in a browser, the two will disagree about any text you
        shortened or measured, and React will complain. It also means a test can
        pass on one machine and fail on another. Our version cannot drift like
        this, because it does not depend on any outside data.
      </p>
    </div>
  </section>

  <!-- ========================================================= safety -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Safe cutting</p>
        <h2>Where you are allowed to cut text short</h2>
        <p class="lede">
          When you shorten a label with <code>truncate()</code>, you have to cut
          somewhere. The browser's rules are about how text is stored, not how it
          is written, so some of the places it offers are places no reader would
          accept — a Thai vowel left hanging on its own, or a Burmese syllable cut
          in half.
        </p>
        <p class="lede">
          We checked this with separate code that shares nothing with the
          splitter, so a bug in one cannot mark its own homework.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Locale</th>
              <th scope="col">Cut points the browser offers</th>
              <th scope="col">Unsafe</th>
              <th scope="col">Rate</th>
              <th scope="col">Ours</th>
              <th scope="col">Usual reason</th>
            </tr>
          </thead>
          <tbody>
            {
              safety.map((r) => (
                <tr>
                  <th scope="row"><code>{r.locale}</code></th>
                  <td>{num(r.offsets)}</td>
                  <td class={r.illegal > 0 ? "bad" : ""}>{r.illegal}</td>
                  <td class={r.illegal > 0 ? "bad" : ""}>
                    {pct((r.illegal / r.offsets) * 100)}%
                  </td>
                  <td class="win">0 · 0.0%</td>
                  <td class="muted">{r.reason}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="note">
        Khmer shows zero here because this table was made on the newest version.
        On Node 20 and Node 22 the same table shows 44 unsafe cut points, 17.7%,
        all of them stacked Khmer letters coming apart. So the fault depends on
        which machine you run it on, not on the text. To be fair to the browser:
        its <em>word</em> boundaries are safe everywhere. The problem is only with
        the finer, letter-level ones — which are exactly what shortening text
        uses.
      </p>
    </div>
  </section>

  <!-- =================================================== availability -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Availability</p>
        <h2>Sometimes the browser's version is not there at all</h2>
      </div>

      <div class="grid grid--3">
        <article class="panel avail avail--bad">
          <h3>The browser's own</h3>
          <p class="avail__verdict">Crashes</p>
          <p class="muted">
            Missing on React Native, on slimmed-down builds of Node, and on
            several edge and embedded platforms. Checking for it first does not
            help: without it there is simply nothing to fall back on.
          </p>
        </article>
        <article class="panel avail">
          <h3>Spelling rules only</h3>
          <p class="avail__verdict avail__verdict--ok">Works</p>
          <p class="muted">No outside data, nothing to be missing.</p>
        </article>
        <article class="panel avail">
          <h3>Rules + word list</h3>
          <p class="avail__verdict avail__verdict--ok">Works</p>
          <p class="muted">
            The one we ship. We check this by deleting the browser's version and
            running the whole test suite again.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================================================== throughput -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">The cost</p>
        <h2>What we gave up: speed and download size</h2>
        <p class="lede">
          The browser's version is written in C++ and is about five to seven times
          faster. It also costs nothing to download. Both of those are real
          downsides, so here they are.
        </p>
      </div>

      <div class="cost">
        <div>
          <h3 class="cost__title">Speed, letters per millisecond</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Locale</th>
                  <th scope="col">A</th>
                  <th scope="col">B</th>
                  <th scope="col">C</th>
                </tr>
              </thead>
              <tbody>
                {
                  throughput.map((r) => (
                    <tr>
                      <th scope="row"><code>{r.locale}</code></th>
                      <td>{num(r.intl)}</td>
                      <td>{num(r.rules)}</td>
                      <td>{num(r.lexical)}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="note">
            In real terms: C splits a 60-letter button label in about 16
            millionths of a second, and a 2,000-letter paragraph in about half a
            thousandth. Nobody can notice that while a page is drawing. It would
            matter if you were processing millions of documents, which is not what
            this is for.
          </p>
        </div>

        <div>
          <h3 class="cost__title">Download size, compressed</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Target</th>
                  <th scope="col">min</th>
                  <th scope="col">gzip</th>
                  <th scope="col">marginal</th>
                </tr>
              </thead>
              <tbody>
                {
                  footprint.map((r) => (
                    <tr>
                      <th scope="row">{r.target}</th>
                      <td>{r.min} KB</td>
                      <td>{r.gzip} KB</td>
                      <td class={r.marginal !== "—" ? "win" : "muted"}>{r.marginal}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="note">
            The word lists are 7.7 KB of that, roughly 220 words per language. If
            you only need text to wrap properly, you can drop them:
          </p>
          <CodeBlock
            code={`import { setSegmentationEngine, orthographicEngine } from "selakata";

// 2.3 KB instead of 10. Wrapping and shortening stay safe.
// Word counts get rougher.
setSegmentationEngine(orthographicEngine);`}
            label="Smaller, but less accurate"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================= decision -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">What we chose</p>
        <h2>We ship C, and you can switch to B</h2>
      </div>

      <ul class="reasons">
        <li>
          <strong>More accurate than the browser</strong> on sentences it had
          never seen: 96.9 against 93.5, winning four languages out of five.
        </li>
        <li>
          <strong>Always there</strong>, which the browser's version is not on
          React Native or any slimmed-down platform.
        </li>
        <li>
          <strong>Always the same answer.</strong> Identical on all three
          versions we tried, where the browser changed its mind on 8.6% of
          sentences. If your app renders on a server and then in a browser, that
          is a correctness problem, not a nice-to-have.
        </li>
        <li>
          <strong>It never cuts text in a broken place</strong>, where the
          browser's finer boundaries are unsafe on 20% of Thai, 23% of Lao, 47% of
          Burmese, and — depending on the machine — 18% of Khmer.
        </li>
        <li>
          <strong>Cheap enough.</strong> 10 KB to download, and about 16
          millionths of a second per label.
        </li>
      </ul>

      <div class="limits">
        <h3>What these numbers do not tell you</h3>
        <ul>
          <li>
            We used 125 sentences across five languages, marked up by the author
            against ordinary writing practice rather than an official standard.
            That is enough to tell these three apart. It is not enough to publish
            as a league table.
          </li>
          <li>
            There is no single right answer at the edges. Thai compound words and
            Burmese grammar words are judgement calls. What you can trust is the
            gap between the three, since all three were judged the same way.
          </li>
          <li>
            The word lists were typed in by hand and hold about 220 common words
            per language. They are not a dictionary.
          </li>
          <li>
            We kept the browser's tools for plurals, numbers, and dates on
            purpose. Those have one published right answer, and when the browser
            updates them, that is a fix arriving. Splitting words is a judgement
            call, which is why that one is ours.
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(56px, 6vw, 92px) 0;
  }

  .head .lede {
    margin-top: 20px;
  }

  .h-code {
    font-size: 0.72em;
    color: var(--jade);
    letter-spacing: 0;
  }

  .head__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 30px;
  }

  /* ------------------------------------------------------- approaches */

  .approach__key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid var(--seam-strong);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .approach--on {
    border-color: rgb(47 211 180 / 34%);
  }

  .approach--on .approach__key {
    background: var(--jade);
    border-color: var(--jade);
    color: #04120f;
  }

  .panel p {
    margin-top: 11px;
    font-size: 0.92rem;
  }

  /* ------------------------------------------------------------ table */

  .win {
    color: var(--jade);
    font-weight: 550;
  }

  .bad {
    color: var(--ember);
  }

  td {
    font-variant-numeric: tabular-nums;
  }

  .total th,
  .total td {
    border-top: 1px solid var(--seam-strong);
    font-weight: 600;
  }

  .note {
    margin-top: 22px;
    max-width: 74ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .note code,
  .limits code {
    color: var(--jade);
  }

  /* ------------------------------------------------------ determinism */

  .diff {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
    margin-bottom: 30px;
  }

  .diff__stat {
    padding: 24px 26px;
    border: 1px solid rgb(240 163 92 / 30%);
    border-radius: var(--radius);
    background: var(--raised);
  }

  .diff__stat--good {
    border-color: rgb(47 211 180 / 30%);
  }

  .diff__stat strong {
    display: block;
    font-size: 2rem;
    font-weight: 620;
    letter-spacing: -0.035em;
    color: var(--ember);
    font-variant-numeric: tabular-nums;
  }

  .diff__stat--good strong {
    color: var(--jade);
  }

  .diff__stat span {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .sample {
    border: 1px solid var(--seam);
    border-radius: var(--radius);
    background: var(--raised);
    padding: 20px 22px;
  }

  .sample__label {
    color: var(--faint);
    font-size: 0.86rem;
    margin-bottom: 14px;
  }

  .sample__label code {
    font-family: var(--khmer);
    color: var(--text);
  }

  .sample__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid var(--seam);
  }

  .sample__tag {
    flex: none;
    width: 84px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--jade);
  }

  .sample__tag--bad {
    color: var(--ember);
  }

  .sample__text {
    font-family: var(--khmer);
    font-size: 1.35rem;
    line-height: 1.9;
  }

  /* ----------------------------------------------------- availability */

  .avail__verdict {
    font-size: 1.5rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    color: var(--ember);
    margin-top: 8px;
  }

  .avail__verdict--ok {
    color: var(--jade);
  }

  /* ------------------------------------------------------------- cost */

  .cost {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 44px;
    align-items: start;
  }

  .cost > * {
    min-width: 0;
  }

  .cost__title {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 14px;
  }

  .cost .table-wrap table {
    min-width: 340px;
  }

  .cost .code {
    margin-top: 16px;
  }

  /* --------------------------------------------------------- decision */

  .reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--seam);
    max-width: 82ch;
  }

  .reasons li {
    padding: 18px 0 18px 22px;
    border-bottom: 1px solid var(--seam);
    border-left: 1px solid var(--jade-dim);
    color: var(--muted);
    font-size: 0.96rem;
  }

  .reasons strong {
    color: var(--text);
    font-weight: 600;
  }

  .limits {
    margin-top: 52px;
    padding: 26px;
    border: 1px solid var(--seam);
    border-left: 2px solid var(--ember);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--raised);
    max-width: 82ch;
  }

  .limits h3 {
    margin-bottom: 14px;
  }

  .limits ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 11px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }
</style>
