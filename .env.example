# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------

# Must be at least 32 characters. The server refuses to boot on a short value.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Set automatically when running under Docker Compose.
MONGO_CONNECTION_URL=mongodb://root:changeme@mongo:27017/selakata?authSource=admin

# --- AI translation ---------------------------------------------------------

# Required unless GEMINI_USE_VERTEX=true. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Use Vertex AI instead of an AI Studio key. Bills to your GCP project and
# authenticates with a service account. GEMINI_API_KEY is ignored when true.
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# --- Optional ---------------------------------------------------------------

PORT=5000
NODE_ENV=production
JWT_EXPIRY=7d
CORS_ORIGIN=*
MAX_KEYS_PER_PROJECT=20000
MONGO_ROOT_PASSWORD=changeme

# Host port for the documentation site (compose profile "site").
SITE_PORT=8080
